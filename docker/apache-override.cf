# Allow %2F (encoded slashes) in URL path segments to reach PHP intact.
# Without this, Apache decodes %2F → / before routing, which breaks entity IDs
# like https://rp.example.com used as path parameters.
AllowEncodedSlashes NoDecode

RewriteEngine On
RewriteRule ^/.well-known/openid-federation(.*) /${SSP_APACHE_ALIAS}module.php/oidanchor/openid-federation.php$1 [PT]

# Leave Authorization header with Bearer tokens available in requests.
# Solution 1:
RewriteEngine On
RewriteCond %{HTTP:Authorization} .+
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# Solution 2:
#SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

