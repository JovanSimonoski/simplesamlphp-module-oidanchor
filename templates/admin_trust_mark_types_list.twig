{% set pagetitle = 'OIDC Federation Trust Mark Types'|trans %}
{% set frontpage_section = 'oidanchor' %}
{% extends "base.twig" %}

{% block preload %}
<link rel="stylesheet" href="{{ asset('css/admin.css', 'admin') }}">
<style>
  .oidanchor-table { width: 100%; border-collapse: collapse; margin-top: 1em; }
  .oidanchor-table th, .oidanchor-table td { padding: .45em .7em; border: 1px solid #ddd; font-size: .9em; }
  .oidanchor-table th { background: #f4f4f4; text-align: left; }
  .oidanchor-table tr:hover td { background: #fafafa; }
  .badge-inuse { color: #2a6b2a; font-weight: bold; }
  .badge-warn  { color: #9a3a00; font-weight: bold; }
  .flash-success { background: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: .6em 1em; margin-bottom: 1em; border-radius: 3px; }
  .flash-error   { background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: .6em 1em; margin-bottom: 1em; border-radius: 3px; }
</style>
{% endblock %}

{% block content %}
  <div class="pure-g frontpage-menu">
    <div class="pure-u-1">
      <div class="pure-menu pure-menu-horizontal wrapping-menu">
        <ul class="pure-menu-list">
          {%- for id, option in menu %}
          <li class="pure-menu-item{% if frontpage_section == id %} pure-menu-selected{% endif %}">
            <a href="{{ option.url }}" class="pure-menu-link">{{ option.name|trans }}</a>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </div>
  </div>

  <h2>{% trans %}Trust Mark Types{% endtrans %}</h2>

  {% if flash %}
    <div class="flash-{{ flash.type }}">{{ flash.text|e }}</div>
  {% endif %}

  <p>
    <a href="{{ createUrl }}" class="pure-button pure-button-primary">
      + {% trans %}Create new type{% endtrans %}
    </a>
  </p>

  {% if types is empty %}
    <p>{% trans %}No Trust Mark types defined yet.{% endtrans %}</p>
  {% else %}
    <table class="oidanchor-table">
      <thead>
        <tr>
          <th>{% trans %}Trust Mark ID{% endtrans %}</th>
          <th>{% trans %}Name{% endtrans %}</th>
          <th>{% trans %}Default lifetime{% endtrans %}</th>
          <th>{% trans %}Active marks{% endtrans %}</th>
          <th>{% trans %}Updated{% endtrans %}</th>
          <th>{% trans %}Actions{% endtrans %}</th>
        </tr>
      </thead>
      <tbody>
        {% for type in types %}
          {%- set encodedId = type.trustMarkId|url_encode -%}
          {%- set count = activeCounts[type.trustMarkId]|default(0) -%}
          <tr>
            <td><code>{{ type.trustMarkId|e }}</code></td>
            <td>{{ type.name|e }}</td>
            <td>{{ type.defaultLifetime ? type.defaultLifetime ~ 's' : '-' }}</td>
            <td>
              {% if count > 0 %}<span class="badge-inuse">{{ count }}</span>{% else %}0{% endif %}
            </td>
            <td>{{ type.updatedAt ? type.updatedAt|date('Y-m-d H:i') : type.createdAt|date('Y-m-d H:i') }}</td>
            <td>
              <a href="{{ moduleURL('oidanchor/admin/trust-mark-types/' ~ encodedId ~ '/edit') }}"
                 class="pure-button">{% trans %}Edit{% endtrans %}</a>

              <form method="post"
                    action="{{ moduleURL('oidanchor/admin/trust-mark-types/' ~ encodedId ~ '/delete') }}"
                    style="display:inline">
                <input type="hidden" name="csrf_token" value="{{ csrfToken|e }}">
                <button type="submit" class="pure-button pure-button-red"
                        onclick="return confirm('Delete type {{ type.trustMarkId|e('js') }}?{% if count > 0 %} {{ count }} active issued mark(s) will remain and keep their status history.{% endif %}')">
                  {% trans %}Delete{% endtrans %}
                </button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endblock %}
