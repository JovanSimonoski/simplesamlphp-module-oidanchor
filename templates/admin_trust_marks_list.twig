{% set pagetitle = 'OIDC Federation Issued Trust Marks'|trans %}
{% set frontpage_section = 'oidanchor' %}
{% extends "base.twig" %}

{% block preload %}
<link rel="stylesheet" href="{{ asset('css/admin.css', 'admin') }}">
<style>
  .oidanchor-table { width: 100%; border-collapse: collapse; margin-top: 1em; }
  .oidanchor-table th, .oidanchor-table td { padding: .45em .7em; border: 1px solid #ddd; font-size: .9em; }
  .oidanchor-table th { background: #f4f4f4; text-align: left; }
  .oidanchor-table tr:hover td { background: #fafafa; }
  .badge-active  { color: #2a6b2a; font-weight: bold; }
  .badge-revoked { color: #9a3a00; font-weight: bold; }
  .oidanchor-filter { margin-top: 1em; }
  .oidanchor-filter select, .oidanchor-filter input { font-size: .9em; }
  .flash-success { background: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: .6em 1em; margin-bottom: 1em; border-radius: 3px; }
  .flash-error   { background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: .6em 1em; margin-bottom: 1em; border-radius: 3px; }
</style>
{% endblock %}

{% block content %}
  <div class="pure-g frontpage-menu">
    <div class="pure-u-1">
      <div class="pure-menu pure-menu-horizontal wrapping-menu">
        <ul class="pure-menu-list">
          {%- for id, option in menu %}
          <li class="pure-menu-item{% if frontpage_section == id %} pure-menu-selected{% endif %}">
            <a href="{{ option.url }}" class="pure-menu-link">{{ option.name|trans }}</a>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </div>
  </div>

  <h2>{% trans %}Issued Trust Marks{% endtrans %}</h2>

  {% if flash %}
    <div class="flash-{{ flash.type }}">{{ flash.text|e }}</div>
  {% endif %}

  <p>
    <a href="{{ issueUrl }}" class="pure-button pure-button-primary">
      + {% trans %}Issue Trust Mark{% endtrans %}
    </a>
  </p>

  <form method="get" action="{{ listUrl }}" class="pure-form oidanchor-filter">
    <select name="trust_mark_id">
      <option value="">{% trans %}all types{% endtrans %}</option>
      {% for type in types %}
        <option value="{{ type.trustMarkId|e }}" {% if filter.trust_mark_id == type.trustMarkId %}selected{% endif %}>
          {{ type.name|e }}
        </option>
      {% endfor %}
    </select>
    <input type="text" name="sub" value="{{ filter.sub|default('')|e }}" placeholder="sub filter">
    <select name="status">
      <option value="">{% trans %}any status{% endtrans %}</option>
      <option value="active"  {% if filter.status == 'active' %}selected{% endif %}>active</option>
      <option value="revoked" {% if filter.status == 'revoked' %}selected{% endif %}>revoked</option>
    </select>
    <button type="submit" class="pure-button">{% trans %}Filter{% endtrans %}</button>
    <a href="{{ listUrl }}" class="pure-button">{% trans %}Reset{% endtrans %}</a>
  </form>

  {% if marks is empty %}
    <p>{% trans %}No Trust Marks match.{% endtrans %}</p>
  {% else %}
    <table class="oidanchor-table">
      <thead>
        <tr>
          <th>{% trans %}#{% endtrans %}</th>
          <th>{% trans %}Type{% endtrans %}</th>
          <th>{% trans %}Subject{% endtrans %}</th>
          <th>{% trans %}Status{% endtrans %}</th>
          <th>{% trans %}Issued{% endtrans %}</th>
          <th>{% trans %}Expires{% endtrans %}</th>
          <th>{% trans %}Actions{% endtrans %}</th>
        </tr>
      </thead>
      <tbody>
        {% for mark in marks %}
          <tr>
            <td>{{ mark.id }}</td>
            <td><code>{{ mark.trustMarkId|e }}</code></td>
            <td><code>{{ mark.sub|e }}</code></td>
            <td><span class="badge-{{ mark.status }}">{{ mark.status|e }}</span></td>
            <td>{{ mark.iat|date('Y-m-d H:i') }}</td>
            <td>{{ mark.exp ? mark.exp|date('Y-m-d H:i') : '-' }}</td>
            <td>
              <a href="{{ moduleURL('oidanchor/admin/trust-marks/' ~ mark.id ~ '/view') }}"
                 class="pure-button">{% trans %}View{% endtrans %}</a>

              {% if mark.status == 'active' %}
                <form method="post"
                      action="{{ moduleURL('oidanchor/admin/trust-marks/' ~ mark.id ~ '/revoke') }}"
                      style="display:inline">
                  <input type="hidden" name="csrf_token" value="{{ csrfToken|e }}">
                  <button type="submit" class="pure-button pure-button-red"
                          onclick="return confirm('Revoke Trust Mark #{{ mark.id }}?')">
                    {% trans %}Revoke{% endtrans %}
                  </button>
                </form>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endblock %}
